  margin-top: 92px;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.metric {
  min-height: 150px;
  padding: 30px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-right: 1px solid var(--line);
}

.metric:last-child { border-right: 0; }

.metric strong {
  font-family: Manrope, sans-serif;
  font-size: clamp(34px, 4vw, 58px);
  line-height: 1;
  letter-spacing: -.05em;
}

.metric span {
  color: var(--muted);
  font-size: 13px;
  margin-top: 11px;
}

.section-heading {
  display: grid;
  grid-template-columns: 1fr .65fr;
  gap: 40px;
  align-items: end;
  margin-bottom: 48px;
}

.section-heading h2,
.optimization-copy h2,
.contact-card h2 {
  font-size: clamp(38px, 5.1vw, 72px);
  line-height: 1.02;
  margin: 15px 0 0;
}

.section-heading p,
.optimization-copy p,
.contact-card p {
  margin: 0;
  color: var(--muted);
  font-size: 16px;
  max-width: 620px;
}

.project-list {
  display: grid;
  gap: 24px;
}

.project-card {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
}

.project-card.featured {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
}

.project-visual {
  min-height: 520px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
}

.project-card:not(.featured) > .project-visual {
  min-height: 350px;
}

.project-visual::after {
  content: "";
  position: absolute;
  inset: auto -8% -25% auto;
  width: 64%;
  aspect-ratio: 1;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 50%;
  box-shadow:
    0 0 0 40px rgba(255,255,255,.018),
    0 0 0 80px rgba(255,255,255,.012);
}

.visual-tower {
  background:
    linear-gradient(140deg, rgba(216,255,99,.15), transparent 42%),
    linear-gradient(30deg, #1b2130, #101319);
}
.visual-oil {
  background:
    linear-gradient(145deg, rgba(226,159,78,.18), transparent 48%),
    linear-gradient(35deg, #231e18, #101216);
}
.visual-sun {
  background:
    radial-gradient(circle at 20% 20%, rgba(255,218,100,.2), transparent 30%),
    linear-gradient(30deg, #242115, #101318);
}
.visual-shoot {
  background:
    linear-gradient(145deg, rgba(115,168,255,.16), transparent 45%),
    linear-gradient(35deg, #182130, #0f1216);
}
.visual-cat {
  background:
    linear-gradient(145deg, rgba(245,151,199,.14), transparent 42%),
    linear-gradient(35deg, #241a21, #111217);
}

.visual-label {
  position: relative;
  z-index: 2;
  width: fit-content;
  padding: 7px 10px;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 999px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .13em;
  color: rgba(255,255,255,.74);
}

.visual-placeholder {
  position: relative;
  z-index: 2;
  display: grid;
  gap: 4px;
}

.visual-placeholder span {
  font-family: Manrope, sans-serif;
  font-size: clamp(34px, 4vw, 64px);
  font-weight: 800;
  letter-spacing: -.05em;
  line-height: .95;
  max-width: 85%;
}

.project-card.small .visual-placeholder span {
  font-size: clamp(28px, 3vw, 44px);
}

.visual-placeholder small {
  color: rgba(255,255,255,.45);
  font-size: 12px;
}

.project-content {
  padding: 34px;
}

.featured .project-content {
  padding: 42px;
  align-self: center;
}

.project-topline {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  color: var(--muted-2);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.project-content h3 {
  font-size: clamp(34px, 4vw, 58px);
  line-height: 1;
  margin: 18px 0;
}

.project-summary,
.project-content > p {
  color: var(--muted);
  margin-bottom: 28px;
}

.project-kpis {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
  border-radius: 18px;
  overflow: hidden;
}

.project-kpis div {
  background: var(--surface-2);
  padding: 20px;
}

.project-kpis strong {
  display: block;
  font-family: Manrope, sans-serif;
  font-size: 27px;
  letter-spacing: -.04em;
}

.project-kpis span {
  color: var(--muted);
  font-size: 11px;
}

details {
  margin-top: 24px;
  border-top: 1px solid var(--line);
  padding-top: 19px;
}

summary {
  cursor: pointer;
  font-weight: 700;
  font-size: 13px;
}

details ul {
  padding-left: 18px;
  color: var(--muted);
  font-size: 13px;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.project-grid .small:last-child {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: .85fr 1.15fr;
}

.single-stat,
.stat-row {
  color: var(--muted);
  font-size: 13px;
}

.single-stat strong {
  color: var(--text);
  font-size: 18px;
  margin-right: 5px;
}

.stat-row {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
}

.pipeline {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.pipeline-item {
  padding: 32px;
  min-height: 250px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.pipeline-item > span,
.skill-index {
  color: var(--accent);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .12em;
}

.pipeline-item h3,
.skill-card h3 {
  font-size: 25px;
  margin: 54px 0 10px;
}

.pipeline-item p,
.skill-card p {
  color: var(--muted);
  font-size: 14px;
  margin: 0;
}

.optimization-card {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 56px;
  padding: 54px;
  border: 1px solid rgba(216,255,99,.18);
  border-radius: calc(var(--radius) + 6px);
  background:
    radial-gradient(circle at 82% 14%, rgba(216,255,99,.1), transparent 30%),
    linear-gradient(145deg, #141816, #111318);
}

.optimization-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 32px;
}

.optimization-tags span,
.tool-row span {
  padding: 8px 11px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
}

.optimization-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  align-self: stretch;
  background: rgba(255,255,255,.09);
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 20px;
  overflow: hidden;
}

.optimization-stats div {
  min-height: 160px;
  padding: 24px;
  background: rgba(11,13,16,.66);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.optimization-stats strong {
  font-family: Manrope, sans-serif;
  font-size: 34px;
  letter-spacing: -.05em;
}

.optimization-stats span {
  color: var(--muted);
  font-size: 11px;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.skill-card {
  min-height: 310px;
  padding: 30px;
  border: 1px solid var(--line);
  border-radius: 22px;
  background: linear-gradient(160deg, rgba(255,255,255,.035), rgba(255,255,255,.015));
}

.skill-card h3 {
  margin-top: 48px;
}

.tool-row {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
  margin-top: 24px;
}

.skill-card small {
  display: block;
  color: var(--muted-2);
  line-height: 1.5;
  margin-top: 18px;
}

.timeline {
  display: grid;
  grid-template-columns: .32fr .68fr;
  border-top: 1px solid var(--line);
  padding-top: 34px;
}

.timeline-date {
  color: var(--accent);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .09em;
}

.timeline-content h3 {
  font-size: clamp(30px, 4vw, 52px);
  margin-bottom: 8px;
}

.company {
  color: var(--muted-2);
  margin-top: 0;
}

.timeline-content > p,
.timeline-content li {
  color: var(--muted);
}

.timeline-content ul {
  padding-left: 18px;
  margin-top: 26px;
}

.contact-card {
  display: grid;
  grid-template-columns: 1fr .7fr;
  gap: 60px;
  padding: 56px;
  border-radius: calc(var(--radius) + 8px);
  background: var(--accent);
  color: #10120e;
}

.contact-card .eyebrow {
  color: #4d5d1b;
}

.contact-card p {
  color: rgba(16,18,14,.66);
  margin-top: 20px;
}

.contact-links {
  display: grid;
  align-content: center;
}

.contact-links a {
  padding: 18px 0;
  border-bottom: 1px solid rgba(16,18,14,.2);
  display: grid;
  gap: 3px;
}

.contact-links span {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  opacity: .58;
}

.contact-links strong {
  font-size: 15px;
}

footer {
  width: min(calc(100% - 40px), var(--max));
  margin: 0 auto;
  padding: 28px 0 46px;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  gap: 20px;
  color: var(--muted-2);
  font-size: 11px;
}

.reveal {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity .7s ease, transform .7s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 980px) {
  .hero-grid,
  .section-heading,
  .optimization-card,
  .contact-card {
    grid-template-columns: 1fr;
  }

  .hero-card { max-width: 560px; }
  .metrics { grid-template-columns: repeat(2, 1fr); }
  .metric:nth-child(2) { border-right: 0; }
  .metric:nth-child(-n+2) { border-bottom: 1px solid var(--line); }

  .project-card.featured {
    grid-template-columns: 1fr;
  }

  .project-grid {
    grid-template-columns: 1fr;
  }

  .project-grid .small:last-child {
    grid-column: auto;
    grid-template-columns: 1fr;
  }

  .pipeline,
  .skills-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 760px) {
  .site-header {
    width: min(calc(100% - 24px), var(--max));
  }

  .menu-toggle {
    width: 42px;
    height: 42px;
    display: grid;
    place-content: center;
    gap: 5px;
    border: 0;
    border-radius: 50%;
    color: white;
    background: rgba(255,255,255,.07);
    cursor: pointer;
  }

  .menu-toggle span {
    width: 16px;
    height: 1px;
    background: currentColor;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: calc(100% + 9px);
    left: 0;
    right: 0;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(11,13,16,.96);
    flex-direction: column;
    align-items: stretch;
  }

  .nav-links.open { display: flex; }

  .nav-links a {
    padding: 12px 14px;
  }

  .section {
    width: min(calc(100% - 28px), var(--max));
    padding: 80px 0;
  }

  .hero { padding-top: 102px; }
  .metrics { margin-top: 60px; }
  .metric { padding: 22px; min-height: 125px; }

  .project-visual,
  .project-card:not(.featured) > .project-visual {
    min-height: 340px;
  }

  .project-content,
  .featured .project-content {
    padding: 25px;
  }

  .pipeline,
  .skills-grid {
    grid-template-columns: 1fr;
  }

  .pipeline-item {
    min-height: 210px;
  }

  .optimization-card,
  .contact-card {
    padding: 28px;
  }

  .optimization-stats {
    grid-template-columns: 1fr 1fr;
  }

  .timeline {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  footer {
    width: min(calc(100% - 28px), var(--max));
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }
}
